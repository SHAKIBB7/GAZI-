# ==============================================================================
# GAZI SPORTS ENTERPRISE CRICKET PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node / Runtime Environment
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000

# Security & Authentication
JWT_SECRET=replace_with_a_secure_256bit_random_secret_string_for_production
ADMIN_DEFAULT_PASSWORD=replace_with_ultra_secure_super_admin_passphrase

# Frontend Public API URL (Vite client)
VITE_API_URL=https://api.gazisports.com

# Database & Data Persistence Paths
DATABASE_FILE=./server/data/store.json
BACKUP_DIR=./server/backups

# Bangladesh Mobile Financial Services (MFS) Gateways
# bKash Merchant API (v1.2.0-beta)
BKASH_APP_KEY=your_bkash_merchant_app_key
BKASH_APP_SECRET=your_bkash_merchant_app_secret
BKASH_USERNAME=your_bkash_merchant_username
BKASH_PASSWORD=your_bkash_merchant_password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

# Nagad Merchant API
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key

# Domestic Logistics Integration (Pathao Courier)
PATHAO_CLIENT_ID=your_pathao_merchant_client_id
PATHAO_CLIENT_SECRET=your_pathao_merchant_client_secret
PATHAO_USERNAME=your_pathao_account_email
PATHAO_PASSWORD=your_pathao_account_password
PATHAO_STORE_ID=your_pathao_pickup_store_id
PATHAO_BASE_URL=https://api-hermes.pathao.com

# Transactional Email (Order Confirmation & Tracking)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.gazisports.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Gazi Sports Cricket" <orders@gazisports.com>

# Monitoring & Error Telemetry
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
