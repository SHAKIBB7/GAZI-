datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  STRIPE
  COD
}

enum WillowGrade {
  GRADE_1_PLUS
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  KASHMIR_WILLOW
  TENNIS_WOOD
}

enum BatHandleType {
  ROUND
  SEMI_OVAL
  OVAL
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  phone        String?        @unique
  passwordHash String
  role         Role           @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses    Address[]
  sellerProfile SellerProfile?
  orders       Order[]
  reviews      Review[]
  wallet       Wallet?
  cart         Cart?

  @@map("users")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  division      String   // e.g., Dhaka, Chattogram, Rajshahi, Khulna, Sylhet, Barishal, Rangpur, Mymensingh
  district      String   // e.g., Dhaka, Gazipur, Narayanganj
  thana         String   // Upazila / Police Station
  addressLine   String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model SellerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  shopName       String    @unique
  slug           String    @unique
  logoUrl        String?
  bannerUrl      String?
  description    String?
  tradeLicenseNo String?
  bankName       String?
  bankAccountNo  String?
  routingNo      String?
  commissionRate Float     @default(10.0) // 10% marketplace commission
  isVerified     Boolean   @default(false)
  rating         Float     @default(5.0)
  totalSales     Float     @default(0.0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  orderItems     OrderItem[]

  @@map("seller_profiles")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  country     String?   // e.g. England, Australia, India, Pakistan
  website     String?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("brands")
}

model Player {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  country      String
  battingStyle String?   // Left-hand bat, Right-hand bat
  bowlingStyle String?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())

  endorsedProducts Product[]

  @@map("players")
}

model Product {
  id                String          @id @default(uuid())
  sellerId          String?
  brandId           String
  categoryId        String
  playerId          String?
  name              String
  slug              String          @unique
  sku               String          @unique
  description       String
  shortDescription  String?
  basePrice         Float
  discountPrice     Float?
  status            ProductStatus   @default(ACTIVE)
  hasKnockingOption Boolean         @default(false) // True for English/Kashmir willow bats
  isFeatured        Boolean         @default(false)
  isBestSeller      Boolean         @default(false)
  isNewArrival      Boolean         @default(true)
  viewCount         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  seller            SellerProfile?  @relation(fields: [sellerId], references: [id])
  brand             Brand           @relation(fields: [brandId], references: [id])
  category          Category        @relation(fields: [categoryId], references: [id])
  endorsedByPlayer  Player?         @relation(fields: [playerId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]
  specifications    ProductSpecification[]
  reviews           Review[]
  flashSaleItems    FlashSaleItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([playerId])
  @@map("products")
}

model ProductVariant {
  id            String         @id @default(uuid())
  productId     String
  sku           String         @unique
  title         String         // e.g., "Short Handle / 2.8 lbs / Grade 1"
  size          String?        // SH, LH, Harrow, 6, 5, 4, 3
  weightOz      Float?         // Weight in pounds/ounces, e.g. 2.85 lbs
  weightGrams   Int?           // e.g. 1180 grams
  willowGrade   WillowGrade?   // GRADE_1_PLUS, GRADE_1, etc.
  grainCount    Int?           // e.g. 8 to 12 grains
  handleType    BatHandleType? // ROUND, OVAL
  color         String?
  price         Float
  stock         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  url         String
  altText     String?
  isPrimary   Boolean  @default(false)
  is360Frame  Boolean  @default(false)
  sortOrder   Int      @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String
  key       String  // e.g. "Sweet Spot", "Edge Profile", "Spine Profile", "Bow"
  value     String  // e.g. "Mid to Low (approx 215mm)", "38mm - 40mm", "65mm", "Subtle Pro Bow"

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id                     String         @id @default(uuid())
  cartId                 String
  variantId              String
  quantity               Int            @default(1)
  addKnockingService     Boolean        @default(false) // 15,000 hammer strikes + oiling + scuff sheet
  knockingServiceFee     Float          @default(0.0)

  cart                   Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // e.g. "CSP-2026-8921"
  userId          String?
  customerName    String
  customerPhone   String
  customerEmail   String
  shippingAddress Json           // Full address object snapshot
  subTotal        Float
  knockingTotal   Float          @default(0.0)
  shippingFee     Float          @default(0.0)
  discountAmount  Float          @default(0.0)
  couponCode      String?
  totalAmount     Float
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentGateway @default(COD)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User?          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]

  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  sellerId           String?
  variantId          String
  productTitle       String
  variantTitle       String
  unitPrice          Float
  quantity           Int
  totalPrice         Float
  hasKnockingService Boolean         @default(false)
  knockingFee        Float           @default(0.0)

  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller             SellerProfile?  @relation(fields: [sellerId], references: [id])
  variant            ProductVariant  @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String         @id @default(uuid())
  orderId         String
  gateway         PaymentGateway
  transactionId   String?        @unique
  amount          Float
  currency        String         @default("BDT")
  status          PaymentStatus  @default(PENDING)
  gatewayResponse Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipment {
  id           String      @id @default(uuid())
  orderId      String
  courier      String      // Steadfast, Pathao, RedX, DHL
  trackingCode String?     @unique
  trackingUrl  String?
  status       OrderStatus @default(PROCESSING)
  shippedAt    DateTime?
  deliveredAt  DateTime?

  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    // PERCENTAGE or FIXED
  discountValue  Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  usageLimit     Int?
  usedCount      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

model FlashSale {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  bannerUrl   String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean         @default(true)
  items       FlashSaleItem[]

  @@map("flash_sales")
}

model FlashSaleItem {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  salePrice   Float
  stockLimit  Int
  soldCount   Int       @default(0)

  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("flash_sale_items")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  balance       Float    @default(0.0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}
